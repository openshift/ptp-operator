        </mxCell>
        <mxCell id="e-l7" value="L7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;strokeWidth=2;endArrow=block;endFill=1;fillColor=#9673a6;strokeColor=#9673a6;fontSize=10;fontStyle=1;fontColor=#9673a6;" edge="1" parent="1" source="srv1-ens1f0" target="srv3-ens7f0">
          <mxGeometry relative="1" as="geometry">
