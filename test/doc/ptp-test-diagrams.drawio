        <mxCell id="legend-links" value="&lt;b&gt;Links (point-to-point netdevsim)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;■&lt;/font&gt; &lt;b&gt;L1&lt;/b&gt; worker.ens1f0 ↔ worker2.ens3f0 — GM ↔ BC1 slave / OC&lt;br&gt;&lt;font color=&quot;#d79b00&quot;&gt;■&lt;/font&gt; &lt;b&gt;L2&lt;/b&gt; worker.ens2f0 ↔ worker2.ens3f1 — GM ↔ BC2 slave&lt;br&gt;&lt;font color=&quot;#82b366&quot;&gt;■&lt;/font&gt; &lt;b&gt;L3&lt;/b&gt; worker.ens1f1 ↔ worker3.ens5f0 — BC1 master ↔ slave 1&lt;br&gt;&lt;font color=&quot;#9673a6&quot;&gt;■&lt;/font&gt; &lt;b&gt;L4&lt;/b&gt; worker.ens2f1 ↔ worker3.ens6f0 — BC2 master ↔ slave 2&lt;br&gt;&lt;font color=&quot;#d6b656&quot;&gt;■&lt;/font&gt; &lt;b&gt;L5&lt;/b&gt; worker2.ens4f0 ↔ worker3.ens7f0 — GM ↔ follower port 0&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;■&lt;/font&gt; &lt;b&gt;L6&lt;/b&gt; worker2.ens4f1 ↔ worker3.ens7f1 — GM ↔ follower port 1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="770" y="100" width="310" height="200" as="geometry" />
        </mxCell>
        <mxCell id="legend-scenarios" value="&lt;b&gt;Scenario roles&lt;/b&gt;&lt;br&gt;&lt;b&gt;OC&lt;/b&gt;: GM = worker2, slave = worker (any link, e.g. L1)&lt;br&gt;&lt;b&gt;BC&lt;/b&gt;: GM = worker2 → BC = worker nic1 → slave1 = worker3 (L1, L3)&lt;br&gt;&lt;b&gt;DualNICBC / HA&lt;/b&gt;: GM = worker2 nic1 (ens3f0 + ens3f1), BC1 = worker nic1, BC2 = worker nic2, slave1/2 = worker3 (L1–L4)&lt;br&gt;&lt;b&gt;DualFollower&lt;/b&gt;: GM = worker2 nic2 (ens4f0 + ens4f1), follower = worker3 nic3 (ens7f0 + ens7f1) (L5, L6)&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;Each link is a 2-port LAN (no switch). Ports on the same NIC share one PHC. A GM feeding two remote ports uses two ports on the same NIC.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="770" y="340" width="310" height="330" as="geometry" />
