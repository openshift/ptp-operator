        <mxCell id="srv3-ens6f0" value="&lt;b&gt;ens6f0&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bbbbbb;fontColor=#999999;fontSize=11;" vertex="1" parent="srv3-nic2">
